.seat {
  padding: 0;
  border-radius: 10px;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.active {
  filter: drop-shadow(0 0 8px rgba(217, 164, 65, 0.72));
}

.seat-head {
  width: 132px;
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 5px;
  padding: 4px 8px 4px 4px;
  border-radius: 999px;
  background: rgba(4, 30, 35, 0.68);
  color: #f9edd0;
}

.seat-avatar {
  width: 30px;
  height: 30px;
  line-height: 30px;
  border-radius: 50%;
  text-align: center;
  background: linear-gradient(180deg, #dce7ee, #8fb1c1);
  color: #12372a;
  font-size: 12px;
  font-weight: 800;
}

.seat-meta {
  min-width: 0;
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 4px;
}

.name {
  max-width: 70px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
  font-weight: 700;
}

.tag {
  padding: 0 5px;
  border-radius: 999px;
  background: #f7e1a6;
  color: #725018;
  font-size: 11px;
}

.dealer {
  background: #f7e1a6;
  color: #725018;
}

.count {
  color: rgba(249, 237, 208, 0.75);
  font-size: 11px;
}

.backs {
  display: flex;
  gap: 2px;
  margin-bottom: 5px;
  overflow: hidden;
}

.left .backs,
.right .backs {
  width: 28px;
  max-height: 216px;
  flex-direction: column;
  gap: 1px;
}

.left .seat-head,
.right .seat-head {
  width: 118px;
}

.left,
.right {
  display: flex;
  flex-direction: column;
  align-items: center;
}
