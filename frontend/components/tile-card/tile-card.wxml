<view
  class="tile {{tileClass}} {{selected ? 'selected' : ''}} {{disabled ? 'disabled' : ''}} {{small ? 'small' : ''}} {{latest ? 'latest' : ''}} {{back ? 'back' : ''}}"
  bindtap="onTap"
>
  <block wx:if="{{back}}">
    <image class="tile-image" src="/assets/tiles/tile_back.png" mode="aspectFit" />
  </block>
  <block wx:else>
    <image class="tile-image" src="{{image}}" mode="aspectFit" />
    <text class="tile-label fallback">{{label}}</text>
    <text wx:if="{{isXiaoJi}}" class="xiaoji-mark">小鸡</text>
  </block>
</view>
