.tile {
  width: 62rpx;
  height: 86rpx;
  border-radius: 8rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(118, 91, 51, 0.32);
  box-shadow: 0 7rpx 0 #b99e75, 0 10rpx 14rpx rgba(31, 35, 28, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: transform 160ms ease, opacity 160ms ease;
}

.tile.small {
  width: 40rpx;
  height: 56rpx;
  box-shadow: 0 4rpx 0 #b99e75, 0 7rpx 10rpx rgba(31, 35, 28, 0.14);
}

.selected {
  transform: translateY(-18rpx);
  border-color: #d9a441;
}

.disabled {
  opacity: 0.42;
}

.latest {
  border-color: #e05643;
}

.back {
  background: #23605b;
  border-color: #174541;
}

.tile-image {
  width: 86%;
  height: 86%;
}

.tile-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #17231d;
}

.fallback {
  display: none;
}

.small .tile-label {
  font-size: 19rpx;
}

.tile-wan .tile-label,
.tile-dragon .tile-label {
  color: #b93f36;
}

.tile-tong .tile-label {
  color: #176b4d;
}

.tile-tiao .tile-label,
.tile-wind .tile-label {
  color: #1f5f8b;
}

.xiaoji-mark {
  position: absolute;
  right: 3rpx;
  bottom: 2rpx;
  padding: 0 4rpx;
  border-radius: 4rpx;
  background: rgba(255, 246, 218, 0.92);
  font-size: 13rpx;
  color: #b36b16;
}

.back-mark {
  font-size: 28rpx;
  font-weight: 700;
}
