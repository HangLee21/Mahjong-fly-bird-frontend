.status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #ece6d9;
  color: #68736b;
  font-size: 22rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9aa19a;
}

.CONNECTED .dot {
  background: #176b4d;
}

.RECONNECTING .dot,
.CONNECTING .dot {
  background: #d9a441;
}

.ERROR .dot,
.DISCONNECTED .dot {
  background: #b93f36;
}
