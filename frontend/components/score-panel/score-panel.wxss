.score {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.desc {
  color: #68736b;
}

.delta,
.fan {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eadfca;
}

.win {
  color: #b93f36;
  font-weight: 700;
}

.lose {
  color: #176b4d;
}
