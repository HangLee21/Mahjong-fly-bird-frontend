<view wx:if="{{result}}" class="score">
  <text class="title">{{result.title}}</text>
  <text class="desc">{{result.description}}</text>
  <view class="deltas">
    <view wx:for="{{result.scoreDelta}}" wx:key="index" class="delta">
      <text>座位 {{index}}</text>
      <text class="{{item > 0 ? 'win' : 'lose'}}">{{item}}</text>
    </view>
  </view>
  <view class="fans">
    <view wx:for="{{result.fanItems}}" wx:key="code" class="fan">
      <text>{{item.name}}</text>
      <text>{{item.fan !== undefined ? item.fan + '番' : ''}} {{item.points}}分</text>
    </view>
  </view>
</view>
