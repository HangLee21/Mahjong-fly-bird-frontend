<view class="seats">
  <view wx:for="{{seats}}" wx:key="seatIndex" class="seat">
    <view>
      <text class="name">{{item.user ? item.user.nickname : '空座位'}}</text>
      <text wx:if="{{item.isOwner}}" class="tag">房主</text>
      <text wx:if="{{item.isAI}}" class="tag">AI</text>
    </view>
    <text class="{{item.isReady ? 'ready' : 'waiting'}}">{{item.isReady ? '已准备' : '未准备'}}</text>
    <button wx:if="{{!item.user && canAddAi}}" data-index="{{item.seatIndex}}" bindtap="onAddAi">加 AI</button>
  </view>
</view>
