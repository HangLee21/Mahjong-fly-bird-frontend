.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(244, 240, 230, 0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #d9cfbd;
  border-top-color: #176b4d;
  border-radius: 50%;
  animation: spin 900ms linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
