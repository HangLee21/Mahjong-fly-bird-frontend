.board {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.topbar,
.self-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.topbar {
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: #12372a;
  color: #f9edd0;
  font-size: 22rpx;
}

.table-scene {
  position: relative;
  min-height: 720rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.13), transparent 38%),
    radial-gradient(circle at 50% 46%, #2f8a68 0%, #176b4d 54%, #104435 100%);
  border: 8rpx solid #6f4a27;
  box-shadow: inset 0 0 0 4rpx rgba(255, 238, 186, 0.16), 0 18rpx 32rpx rgba(24, 28, 20, 0.2);
}

.table-surface {
  position: absolute;
  left: 126rpx;
  right: 126rpx;
  top: 170rpx;
  bottom: 122rpx;
  border-radius: 28rpx;
  background: rgba(8, 60, 43, 0.34);
  border: 2rpx solid rgba(249, 237, 208, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.table-ring {
  position: absolute;
  inset: 28rpx;
  border: 2rpx dashed rgba(249, 237, 208, 0.22);
  border-radius: 24rpx;
}

.center-info {
  position: relative;
  z-index: 1;
  width: 270rpx;
  min-height: 210rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: rgba(9, 43, 34, 0.72);
  color: #f9edd0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
}

.round-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.turn-label {
  font-size: 20rpx;
  color: rgba(249, 237, 208, 0.72);
}

.turn-value {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #d9a441;
  color: #17231d;
  font-weight: 700;
}

.kong-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.label {
  color: rgba(249, 237, 208, 0.72);
  font-size: 22rpx;
}

.kong-tiles,
.wall-info {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.wall-info {
  color: rgba(249, 237, 208, 0.76);
  font-size: 20rpx;
}

.opponent-seat {
  position: absolute;
  z-index: 2;
  width: 260rpx;
}

.seat-top {
  left: 50%;
  top: 18rpx;
  transform: translateX(-50%);
}

.seat-left {
  left: 14rpx;
  top: 246rpx;
}

.seat-right {
  right: 14rpx;
  top: 246rpx;
}

.self-discards {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 18rpx;
  min-height: 76rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.1);
}

.self-area {
  margin-top: -4rpx;
}

.self {
  padding: 18rpx;
  border-color: #d5c39b;
  background: #fffaf0;
}

.self-head {
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
