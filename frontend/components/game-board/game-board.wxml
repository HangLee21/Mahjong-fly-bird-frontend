<view wx:if="{{view}}" class="board">
  <canvas
    canvas-id="gameTableCanvas"
    class="table-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
    disable-scroll="true"
    bindtap="onCanvasTap"
  ></canvas>

  <view class="action-dock">
    <action-panel
      actions="{{view.legalActions}}"
      submitting="{{submitting}}"
      selectedTile="{{selectedTile}}"
      bind:submitAction="onSubmitAction"
    />
  </view>
</view>
