{
  "name": "mahjong-fly-bird-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "曲靖飞小鸡微信小程序前端",
  "miniprogram": "miniprogram",
  "scripts": {
    "build:npm": "echo \"Use WeChat DevTools: Tools > Build npm\"",
    "build:ts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "format": "prettier --write \"**/*.{ts,json,wxml,wxss,md}\"",
    "ci:preview": "miniprogram-ci preview",
    "ci:upload": "miniprogram-ci upload"
  },
  "dependencies": {
    "tdesign-miniprogram": "^1.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "miniprogram-api-typings": "^4.0.3",
    "miniprogram-ci": "^2.0.6",
    "ts-jest": "^29.4.10",
    "typescript": "^5.4.5"
  }
}
