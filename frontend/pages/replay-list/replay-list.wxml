<view class="page">
  <text class="screen-title">牌谱</text>
  <view class="list">
    <view wx:for="{{items}}" wx:key="gameId" class="panel item" data-id="{{item.gameId}}" bindtap="onOpen">
      <text class="title">{{item.title}}</text>
      <text class="muted">房间 {{item.roomId}}</text>
      <text wx:if="{{item.result}}">{{item.result.title}}</text>
    </view>
  </view>
</view>
