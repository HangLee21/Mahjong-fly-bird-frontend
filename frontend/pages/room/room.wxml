<view class="page room">
  <view wx:if="{{room}}" class="header">
    <view>
      <text class="screen-title">房间 {{room.roomId}}</text>
      <text class="muted">规则：{{room.rules.preset}}</text>
    </view>
    <connection-status status="{{wsStatus}}" />
  </view>
  <view wx:if="{{room}}" class="panel">
    <room-seat-list seats="{{room.seats}}" canAddAi="{{true}}" bind:addAi="onAddAi" />
  </view>
  <view wx:if="{{room}}" class="panel rules">
    <text>吃牌：{{room.rules.allowChow ? '开启' : '关闭'}}</text>
    <text>番数上限：{{room.rules.fanCap}} 番</text>
    <text>公开杠牌：{{room.rules.publicKongTiles}} 张</text>
    <text>一炮多响：{{room.rules.allowMultiWin ? '允许' : '不允许'}}</text>
  </view>
  <button class="primary-btn" bindtap="onStart">开始游戏</button>
</view>
