<view class="page game">
  <game-board
    view="{{view}}"
    legalDiscardTiles="{{legalDiscardTiles}}"
    selectedTile="{{selectedTile}}"
    submitting="{{submitting}}"
    bind:selectTile="onSelectTile"
    bind:submitAction="onSubmitAction"
  />
  <loading-mask visible="{{loading}}" text="同步后端视图" />
</view>
