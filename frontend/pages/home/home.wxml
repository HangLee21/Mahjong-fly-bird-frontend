<view class="page home">
  <view class="header">
    <view wx:if="{{user}}">
      <text class="screen-title">大厅</text>
      <text class="muted">你好，{{user.nickname || '玩家'}}</text>
    </view>
    <button class="logout" bindtap="onLogout">退出</button>
  </view>
  <view class="panel actions">
    <button class="primary-btn" loading="{{loading}}" bindtap="onCreateRoom">创建房间</button>
    <view class="join">
      <input placeholder="输入房间号" value="{{roomId}}" bindinput="onRoomInput" />
      <button bindtap="onJoinRoom">加入</button>
    </view>
    <button bindtap="onReplay">牌谱回放</button>
  </view>
  <view class="panel rule">
    <text class="rule-title">规则提示</text>
    <text>1 条为小鸡万能牌，可参与暗杠、加杠、和牌；吃碰杠胡、振听、流局和番种均由后端判定。</text>
    <text>开局公开两张杠牌，杠后从公开杠牌中取一张并补翻，前端只展示后端返回结果。</text>
  </view>
</view>
