.home {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logout {
  width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.join {
  display: flex;
  gap: 12rpx;
}

input {
  flex: 1;
  height: 78rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d9cfbd;
  border-radius: 8rpx;
  background: #fffdf6;
}

.rule {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #4d5a50;
  line-height: 1.6;
}

.rule-title {
  font-weight: 700;
  color: #17231d;
}
